.ancient-page { padding-bottom: 56rpx; }

.debug-banner { padding: 16rpx 20rpx; margin-bottom: 16rpx; border-radius: 12rpx; background: #eaf7ef; color: #1d7a4d; font-size: 26rpx; font-weight: 600; }

.page-intro { display: flex; align-items: flex-start; justify-content: space-between; padding: 16rpx; margin-bottom: 16rpx; }

.intro-main { min-width: 0; flex: 1; }

.eyebrow { color: #1d7a4d; font-size: 24rpx; font-weight: 600; }

.page-title { margin-top: 8rpx; color: #191919; font-size: 42rpx; font-weight: 600; }

.page-subtitle { margin-top: 10rpx; color: rgba(0, 0, 0, 0.52); font-size: 26rpx; line-height: 1.45; }

.map-button { width: 126rpx; height: 68rpx; flex: 0 0 126rpx; border-radius: 12rpx; color: #1d7a4d; background: rgba(29, 122, 77, 0.1); font-size: 27rpx; }

.summary-row { display: flex; }

.summary-item { flex: 1; min-height: 126rpx; padding: 22rpx 14rpx; text-align: center; }

.summary-number { color: #1d7a4d; font-size: 34rpx; font-weight: 600; }

.summary-label { margin-top: 10rpx; color: rgba(0, 0, 0, 0.5); font-size: 23rpx; }

.search-bar { margin-top: 18rpx; padding: 10rpx 14rpx; display: flex; align-items: center; border-radius: 16rpx; }

.search-input { flex: 1; min-width: 0; height: 68rpx; font-size: 26rpx; }

.search-clear { margin-left: 12rpx; width: 92rpx; height: 60rpx; border-radius: 10rpx; color: #1d7a4d; background: rgba(29, 122, 77, 0.08); font-size: 24rpx; }

.simple-filters { margin-top: 18rpx; display: flex; flex-wrap: wrap; }

.filter-pill { min-width: 126rpx; height: 64rpx; padding: 0 22rpx; border-radius: 32rpx; background: #ffffff; color: rgba(0, 0, 0, 0.55); font-size: 26rpx; display: flex; align-items: center; justify-content: center; }

.filter-pill.active { color: #ffffff; background: #1d7a4d; }

.section-head { margin: 34rpx 8rpx 16rpx; display: flex; align-items: flex-end; justify-content: space-between; }

.section-title { color: #191919; font-size: 34rpx; font-weight: 600; }

.section-subtitle { margin-top: 6rpx; color: rgba(0, 0, 0, 0.5); font-size: 24rpx; }

.result-count { color: rgba(0, 0, 0, 0.45); font-size: 24rpx; }

.tree-card { min-height: 140rpx; margin-bottom: 16rpx; padding: 16rpx; display: flex; align-items: center; }

.tree-main { min-width: 0; flex: 1; }

.tree-main-full { margin-left: 0; }

.tree-topline { display: flex; align-items: center; }

.tree-species { color: #191919; font-size: 32rpx; font-weight: 600; }

.status-tag { margin-left: 12rpx; min-height: 38rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 22rpx; display: flex; align-items: center; }

.status-tag.healthy { color: #1d7a4d; background: rgba(29, 122, 77, 0.1); }

.status-tag.watch { color: #b7791f; background: rgba(183, 121, 31, 0.12); }

.tree-id, .tree-meta, .tree-location { margin-top: 8rpx; color: rgba(0, 0, 0, 0.5); font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.tree-location { color: rgba(0, 0, 0, 0.68); }

.pagination-row { margin-top: 18rpx; display: flex; align-items: center; justify-content: space-between; }

.page-btn { width: 150rpx; height: 70rpx; border-radius: 12rpx; background: rgba(29, 122, 77, 0.08); color: #1d7a4d; font-size: 25rpx; }


.page-info { color: rgba(0, 0, 0, 0.52); font-size: 24rpx; }

.empty-panel { margin-top: 16rpx; padding: 60rpx 24rpx; text-align: center; color: rgba(0, 0, 0, 0.46); font-size: 27rpx; background: rgba(255, 255, 255, 0.78); border: 1rpx solid rgba(49, 96, 61, 0.08); border-radius: 16rpx; }



.detail-mask {

  position: fixed;

  top: 0;

  left: 0;

  right: 0;

  bottom: 0;

  background: rgba(0, 0, 0, 0.28);

  display: flex;

  align-items: center;

  justify-content: center;

  z-index: 50;

}

.detail-panel {

  width: 86vw;

  max-width: 680rpx;

  padding: 24rpx;

  background: #fff;

  border-radius: 18rpx;

}

.detail-head {

  display: flex;

  justify-content: space-between;

  margin-bottom: 16rpx;

}

.detail-title {

  font-size: 34rpx;

  font-weight: 700;

}

.detail-subtitle {

  margin-top: 4rpx;

  color: #8a8f98;

  font-size: 22rpx;

}

.detail-grid {

  display: flex;

  flex-wrap: wrap;

  margin: 0 -6rpx;

}

.detail-item {

  width: 50%;

  box-sizing: border-box;

  padding: 0 6rpx 12rpx;

}

.detail-item-box {

  display: flex;

  flex-direction: column;

  padding: 14rpx 16rpx;

  background: #f7f8fa;

  border-radius: 12rpx;

}

.detail-key {

  color: #8a8f98;

  font-size: 20rpx;

  margin-bottom: 4rpx;

}

.detail-val {

  font-size: 24rpx;

  color: #2b2f36;

  word-break: break-all;

}

.detail-actions {

  display: flex;

  margin-top: 18rpx;

}

.detail-btn {

  flex: 1;

  height: 72rpx;

  line-height: 72rpx;

  border-radius: 12rpx;

  background: #1f8f5f;

  color: #fff;

  font-size: 24rpx;

}

.detail-btn.ghost {

  background: #eef2f4;

  color: #2b2f36;

}

.detail-btn + .detail-btn {

  margin-left: 12rpx;

}


.detail-gallery {
  margin-bottom: 18rpx;
}

.detail-cover {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eef2f4;
}

.detail-cover-image {
  width: 100%;
  height: 100%;
}

.detail-gallery-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(0, 0, 0, 0.52);
  font-size: 22rpx;
}

.detail-thumbs {
  margin-top: 10rpx;
  white-space: nowrap;
}

.detail-thumb {
  display: inline-block;
  width: 104rpx;
  height: 104rpx;
  margin-right: 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f7f8fa;
}

.detail-thumb-image {
  width: 100%;
  height: 100%;
}