<view class="map-page">
  <map
    class="forest-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polygons="{{polygons}}"
    polyline="{{polyline}}"
    show-location
    bindmarkertap="onMarkerTap"
  ></map>

  <cover-view class="locate-cover-control" bindtap="onLocateTap">
    {{locating ? "定位中..." : "定位"}}
  </cover-view>

  <cover-view wx:if="{{selectedPlot}}" class="navigate-cover-control" bindtap="openTargetNavigation">
    导航
  </cover-view>

  <view class="nav-summary panel">
    <view class="summary-row">
      <view>
        <view class="dock-title">样方导航</view>
        <view class="dock-subtitle">我的精度 {{myAccuracy}} · 目标距离 {{targetDistance}}</view>
      </view>
      <view class="secondary-btn mini locate-placeholder">
        {{locating ? "定位中..." : "定位"}}
      </view>
    </view>

    <view class="precision-note">
      手机定位精度由设备和环境决定，林下、山谷通常无法稳定保证 2m。
    </view>

    <view wx:if="{{locationError}}" class="location-error" bindtap="onLocationHelpTap">
      {{locationError}} · 点击此处打开权限设置
    </view>

    <view class="selected" wx:if="{{selectedPlot}}">
      <view>
        <view class="selected-title">{{selectedPlot.plotNo}} 样方中心</view>
        <view class="selected-meta">{{selectedPlot.latitudeText}}, {{selectedPlot.longitudeText}}</view>
      </view>
      <view class="primary-btn mini navigate-placeholder">导航</view>
    </view>
  </view>

  <scroll-view class="plot-strip" scroll-x enable-flex>
    <view
      class="plot-chip {{selectedPlot && selectedPlot.plotNo === item.plotNo ? 'active' : ''}}"
      wx:for="{{plotList}}"
      wx:key="plotNo"
      data-plot-no="{{item.plotNo}}"
      bindtap="selectPlot"
      style="border-color: {{item.color}};"
    >
      <view class="chip-title">{{item.plotNo}}</view>
      <view class="chip-distance">{{item.distanceText}}</view>
    </view>
  </scroll-view>
</view>
