<view class="safe-page home-page">
  <view class="home-title-block">
    <image class="home-calligraphy" src="/assets/home/home-calligraphy.png" mode="widthFix" />
  </view>

  <swiper class="home-banner" indicator-dots autoplay circular interval="4200" duration="500">
    <swiper-item wx:for="{{banners}}" wx:key="title">
      <image class="banner-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="banner-shade"></view>
      <view class="banner-copy"><view class="banner-kicker">{{item.kicker}}</view><view class="banner-title">{{item.title}}</view><view class="banner-subtitle">{{item.subtitle}}</view></view>
    </swiper-item>
  </swiper>

  <view class="module-list">
    <view class="module-card" wx:for="{{modules}}" wx:key="key" bindtap="openModule" data-key="{{item.key}}">
      <image class="module-image" src="{{item.image}}" mode="aspectFill" />
      <view class="module-shade"></view>
      <view class="module-content"><view class="module-number">{{item.number}}</view><view class="module-title">{{item.title}}</view><view class="module-link">进入板块 <text>→</text></view></view>
    </view>
  </view>

  <view class="knowledge-entry" bindtap="openKnowledge">
    <view class="knowledge-copy">
      <view class="knowledge-title">资料知识库</view>
      <view class="knowledge-subtitle">下载调查规范、数据模板和项目资料</view>
    </view>
    <view class="knowledge-action">进入 <text>→</text></view>
  </view>
</view>
