.home-page { min-height: 100vh; padding: 12rpx 20rpx 16rpx; display: flex; flex-direction: column; background-color: #f2f7f1; background-image: url("/assets/home/home-paper-texture.jpg"); background-size: cover; background-position: center; }

.home-title-block { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; margin-top: 8rpx; margin-bottom: 12rpx; }

.home-calligraphy { display: block; width: 100%; max-width: 720rpx; height: auto; transform: translateY(4rpx) scale(1.02); transform-origin: center top; }

.home-banner { width: 100%; height: 300rpx; flex: 0 0 300rpx; border-radius: 18rpx; overflow: hidden; background: #dfece3; margin-bottom: 12rpx; position: relative; }

.banner-image, .banner-shade { position: absolute; width: 100%; height: 100%; left: 0; top: 0; }

.banner-shade { background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 20%, rgba(0, 0, 0, 0.7) 100%); }

.banner-copy { position: absolute; left: 30rpx; right: 30rpx; bottom: 54rpx; color: #ffffff; }

.banner-kicker { font-size: 24rpx; opacity: 0.88; }

.banner-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 600; }

.banner-subtitle { margin-top: 8rpx; font-size: 24rpx; opacity: 0.9; }

.module-list { display: flex; flex: 0 0 480rpx; height: 480rpx; align-items: stretch; margin: 0 -6rpx 0; }

.module-card { min-width: 0; flex: 1 1 0; height: 100%; position: relative; overflow: hidden; border-radius: 14rpx; background: #dfece3; margin: 0 6rpx; }

.module-image, .module-shade { position: absolute; width: 100%; height: 100%; left: 0; top: 0; }

.module-shade { background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 12%, rgba(0, 0, 0, 0.76) 100%); }

.module-content { position: absolute; left: 10rpx; right: 10rpx; top: 12rpx; bottom: 12rpx; color: #ffffff; display: flex; flex-direction: column; justify-content: space-between; }

.module-number { color: rgba(255, 255, 255, 0.82); font-size: 16rpx; }

.module-title { margin-top: 4rpx; font-size: 24rpx; line-height: 1.05; font-weight: 600; white-space: pre-line; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

.module-link { margin-top: 6rpx; color: #ffffff; font-size: 16rpx; white-space: nowrap; }

.module-link text { margin-left: 4rpx; font-size: 16rpx; }