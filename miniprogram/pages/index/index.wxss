.hero {
  min-height: 292rpx;
  padding: 40rpx 36rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border-top: 8rpx solid #07c160;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-title {
  color: #191919;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 28rpx;
}

.hero-actions {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 42rpx;
}

.hero-actions button {
  width: 100%;
  min-width: 0;
  height: 84rpx;
  padding: 0 12rpx;
  font-size: 30rpx;
  white-space: nowrap;
}


.user-strip {
  min-height: 104rpx;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.user-status {
  color: #191919;
  font-size: 30rpx;
  font-weight: 500;
}

.user-meta {
  margin-top: 6rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.metric {
  min-height: 148rpx;
  padding: 28rpx;
}

.metric-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #07c160;
}

.metric-value.warn {
  color: #ffc300;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 8rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #191919;
}

.section-subtitle {
  margin-top: 6rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}

.ghost-link {
  color: #576b95;
  font-size: 28rpx;
  font-weight: 500;
}

.health-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.health-item {
  min-height: 116rpx;
  padding: 18rpx 8rpx;
  text-align: center;
}

.health-name {
  min-height: 34rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 22rpx;
}

.health-count {
  margin-top: 12rpx;
  color: #191919;
  font-size: 34rpx;
  font-weight: 600;
}

.recent-panel {
  overflow: hidden;
}

.recent-row {
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.recent-row:last-child {
  border-bottom: 0;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #191919;
}

.recent-meta {
  margin-top: 8rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}
