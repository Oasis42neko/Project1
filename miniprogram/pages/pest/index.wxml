<view class="safe-page pest-page">
  <view class="pest-head"><view><view class="eyebrow">潮州本土适配</view><view class="page-title">林业病虫害观测</view><view class="page-subtitle">发现异常，及时上报，协助后续处置</view></view><button class="report-entry" bindtap="showReportForm">我要上报</button></view>
  <view class="workflow panel"><view class="workflow-step"><view class="step-number">1</view><view><view class="step-title">现场发现</view><view class="step-subtitle">拍照记录</view></view></view><view class="workflow-line"></view><view class="workflow-step"><view class="step-number">2</view><view><view class="step-title">后台审核</view><view class="step-subtitle">分类归档</view></view></view><view class="workflow-line"></view><view class="workflow-step"><view class="step-number">3</view><view><view class="step-title">跟进处置</view><view class="step-subtitle">进度可查</view></view></view></view>
  <scroll-view class="filter-scroll" scroll-x><view class="filter-list"><block wx:for="{{filters}}" wx:key="*this" wx:for-item="item"><view wx:if="{{activeFilter === item}}" class="filter-pill active" bindtap="chooseFilter" data-filter="{{item}}">{{item}}</view><view wx:else class="filter-pill" bindtap="chooseFilter" data-filter="{{item}}">{{item}}</view></block></view></scroll-view>
  <view class="section-head"><view><view class="section-title">观测上报</view><view class="section-subtitle">公开展示演示数据，正式数据将按权限显示</view></view><view class="result-count">{{reports.length}} 条</view></view>
  <view class="report-list"><view class="report-card panel" wx:for="{{reports}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}"><image class="report-image" src="{{item.image}}" mode="aspectFill" /><view class="report-main"><view class="report-topline"><view class="report-type">{{item.type}}</view><view class="report-status {{item.statusClass}}">{{item.status}}</view></view><view class="report-title">{{item.title}}</view><view class="report-meta">{{item.location}}</view><view class="report-meta">{{item.date}} · 紧急程度：{{item.severity}}</view></view><view class="report-arrow">›</view></view></view>
  <view class="placeholder-tip"><view class="tip-title">后续接入内容审核</view><view class="tip-text">照片、位置和文字描述将进入统一审核队列，并支持待审核、已受理、已处置、已办结状态。</view></view>
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail"><view class="detail-sheet" catchtap="stop"><view class="sheet-handle"></view><scroll-view class="sheet-scroll" scroll-y enhanced><view class="sheet-head"><view><view class="sheet-title">{{selectedReport.title}}</view><view class="sheet-id">{{selectedReport.id}}</view></view><button class="close-button" bindtap="closeDetail">×</button></view><image class="sheet-image" src="{{selectedReport.image}}" mode="widthFix" /><view class="detail-grid"><view><text>类型</text><text>{{selectedReport.type}}</text></view><view><text>状态</text><text>{{selectedReport.status}}</text></view><view><text>地点</text><text>{{selectedReport.location}}</text></view><view><text>紧急程度</text><text>{{selectedReport.severity}}</text></view></view><view class="detail-note">{{selectedReport.description}}</view><view wx:if="{{canManageReports}}" class="admin-actions"><button class="ghost-btn admin-action" bindtap="setReportStatus" data-status="已受理">受理</button><button class="secondary-btn admin-action" bindtap="setReportStatus" data-status="已办结">办结</button><button class="danger-btn admin-action" bindtap="setReportStatus" data-status="已驳回">驳回</button></view></scroll-view></view></view>
  <view class="detail-mask" wx:if="{{showForm}}"><view class="detail-sheet report-sheet" catchtap="stop"><view class="sheet-handle"></view><scroll-view class="sheet-scroll" scroll-y enhanced><view class="sheet-head"><view><view class="sheet-title">提交病虫害线索</view><view class="sheet-id">照片可全图查看，并支持大模型辅助识别</view></view><button class="close-button" bindtap="closeReportForm">×</button></view>
    <view class="form-row" bindtap="chooseType"><text class="form-label">类型</text><text class="form-value">{{form.type}} ›</text></view><view class="form-row" bindtap="chooseSeverity"><text class="form-label">紧急程度</text><text class="form-value">{{form.severity}} ›</text></view>
    <view class="location-section"><input class="form-input" value="{{form.location}}" bindinput="inputLocation" placeholder="地点：镇 / 村 / 林区" /><view class="location-actions"><button class="location-action" loading="{{locating}}" disabled="{{locating}}" bindtap="getLocation">自动定位</button><button class="location-action" bindtap="chooseLocation">地图选点</button></view><view wx:if="{{locationHint}}" class="location-hint">{{locationHint}}</view></view><textarea class="form-textarea" value="{{form.description}}" bindinput="inputDescription" placeholder="请描述症状、范围和现场情况" />
    <view class="photo-section-head"><view class="form-label">现场照片</view><button wx:if="{{form.image}}" class="photo-add-button" bindtap="choosePhoto">更换照片</button><button wx:else class="photo-add-button" bindtap="choosePhoto">添加照片</button></view>
    <view class="photo-stage" wx:if="{{form.image}}"><image class="photo-full" src="{{form.image}}" mode="widthFix" /><button class="photo-action photo-remove" bindtap="removePhoto">删除</button><button class="photo-action photo-recognize" loading="{{recognizingPest}}" disabled="{{recognizingPest}}" bindtap="recognizePest">识别</button></view>
    <view class="photo-empty" wx:else>添加现场照片后，可点击图片右上角“识别”</view>
    <view class="pest-recognition" wx:if="{{pestRecognition.visible}}"><view class="recognition-title">豆包病虫害识别结果</view><view class="recognition-main" wx:if="{{pestRecognition.name}}">{{pestRecognition.category}} · {{pestRecognition.name}}</view><view class="recognition-meta" wx:if="{{pestRecognition.severity}}">建议紧急程度：{{pestRecognition.severity}}</view><view class="recognition-meta" wx:if="{{pestRecognition.confidence !== ''}}">置信度：{{pestRecognition.confidence}}</view><view class="recognition-reason" wx:if="{{pestRecognition.description || pestRecognition.reason}}">{{pestRecognition.description || pestRecognition.reason}}</view><view class="recognition-warning" wx:if="{{pestRecognition.uncertain}}">结果仅供参考，请结合现场特征人工确认。</view><view class="recognition-actions"><button class="ghost-btn recognition-button" bindtap="copyPestRecognition">复制结果</button><button class="secondary-btn recognition-button" bindtap="applyPestRecognition">一键填入</button></view></view>
    <button class="submit-button" bindtap="submitReport">提交线索</button>
    </scroll-view></view></view>
</view>

