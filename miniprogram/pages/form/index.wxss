.location-card {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.location-title,
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #191919;
}

.location-meta {
  margin-top: 8rpx;
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}

.location-actions {
  display: flex;
  gap: 12rpx;
}

.locate-btn,
.photo-btn {
  width: 128rpx;
  height: 72rpx;
  padding: 0;
  font-size: 28rpx;
}

.form-section {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
}

.field {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
  display: grid;
  grid-template-columns: 190rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
}

.field:last-child {
  border-bottom: 0;
}

.field-label {
  color: rgba(0, 0, 0, 0.9);
  font-size: 30rpx;
  font-weight: 400;
}

.required {
  margin-left: 4rpx;
  color: #fa5151;
}

.field-input,
.field-textarea {
  width: 100%;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f7f7f7;
  color: #191919;
  font-size: 30rpx;
}

.field-input {
  height: 76rpx;
}

.picker-value {
  line-height: 76rpx;
}

.field-textarea {
  min-height: 160rpx;
  padding-top: 18rpx;
  line-height: 1.5;
}

.unit {
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
}

.section-headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photo-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.photo-item {
  position: relative;
  height: 148rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f2f2f2;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.remove-photo {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 40rpx;
}

.photo-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 26rpx;
}
