.location-card {

  padding: 28rpx 28rpx 32rpx;

}



.location-title-row {

  display: block;

}



.location-title,

.section-title {

  font-size: 34rpx;

  font-weight: 600;

  color: #191919;

  line-height: 1.35;

  white-space: nowrap;

}



.location-subtitle {

  margin-top: 8rpx;

  color: rgba(0, 0, 0, 0.5);

  font-size: 24rpx;

  line-height: 1.45;

}



.map-box {

  position: relative;

  margin-top: 22rpx;

  height: 320rpx;

  border-radius: 12rpx;

  overflow: hidden;

  background: #f2f2f2;

}



.location-map {

  width: 100%;

  height: 100%;

}



.map-empty {

  position: absolute;

  left: 24rpx;

  bottom: 20rpx;

  padding: 8rpx 14rpx;

  border-radius: 8rpx;

  background: rgba(255, 255, 255, 0.92);

  color: rgba(0, 0, 0, 0.7);

  font-size: 24rpx;

}



.coord-panel {

  margin-top: 18rpx;

  padding: 18rpx 0;

  border-top: 1rpx solid rgba(0, 0, 0, 0.08);

  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);

  display: flex;

  flex-wrap: wrap;

}


.coord-format-switch {

  width: 100%;

  margin-bottom: 16rpx;

}

.coord-format-label {

  color: rgba(0, 0, 0, 0.56);

  font-size: 24rpx;

  line-height: 1.35;

}

.coord-format-options {

  display: flex;

  gap: 12rpx;

  margin-top: 8rpx;

}

.coord-format-btn {

  flex: 1 1 0;

  width: 0;

  height: 64rpx;

  margin: 0;

  padding: 0 12rpx;

  border-radius: 8rpx;

  border: 1rpx solid rgba(0, 0, 0, 0.12);

  background: #ffffff;

  color: #191919;

  font-size: 24rpx;

  line-height: 64rpx;

}

.coord-format-btn.active {

  border-color: #1d7a4d;

  background: rgba(29, 122, 77, 0.1);

  color: #1d7a4d;

}



.coord-input-item {

  min-width: 0;

}



.coord-label {

  color: rgba(0, 0, 0, 0.56);

  font-size: 24rpx;

  line-height: 1.35;

}



.coord-input,

.coord-input-wrap {

  box-sizing: border-box;

  width: 100%;

  height: 72rpx;

  margin-top: 8rpx;

  border-radius: 8rpx;

  background: #f7f7f7;

}



.coord-input {

  padding: 0 14rpx;

  color: #191919;

  font-size: 25rpx;

}



.coord-input-wrap {

  display: flex;

  align-items: center;

  padding-right: 12rpx;

}



.coord-input-with-unit {

  flex: 1;

  min-width: 0;

  margin-top: 0;

  background: transparent;

}



.coord-unit {

  flex: none;

  color: rgba(0, 0, 0, 0.5);

  font-size: 24rpx;

}



.manual-location-locked {

  margin-top: 16rpx;

  padding: 14rpx 18rpx;

  border-radius: 8rpx;

  background: rgba(250, 157, 59, 0.1);

  color: #9a5a00;

  font-size: 24rpx;

  line-height: 1.4;

}



.plot-status {

  margin-top: 18rpx;

  padding: 18rpx 20rpx;

  border-radius: 8rpx;

  border: 1rpx solid rgba(0, 0, 0, 0.08);

  background: #f7f7f7;

}



.plot-status.error {

  border-color: rgba(250, 81, 81, 0.42);

  background: rgba(250, 81, 81, 0.08);

}



.plot-status.warning {

  border-color: rgba(250, 157, 59, 0.42);

  background: rgba(250, 157, 59, 0.08);

}



.plot-status.neutral {

  border-color: rgba(7, 193, 96, 0.28);

  background: rgba(7, 193, 96, 0.08);

}



.plot-status-title {

  color: #191919;

  font-size: 28rpx;

  font-weight: 600;

  line-height: 1.35;

}



.plot-status.error .plot-status-title {

  color: #fa5151;

}



.plot-status-desc,

.plot-status-range {

  margin-top: 8rpx;

  color: rgba(0, 0, 0, 0.68);

  font-size: 24rpx;

  line-height: 1.45;

  word-break: break-all;

}



.plot-match-btn {

  width: 100%;

  height: 68rpx;

  margin-top: 14rpx;

  border-radius: 8rpx;

  background: #ffffff;

  color: #1d7a4d;

  font-size: 26rpx;

  line-height: 68rpx;

}



.location-actions {

  margin-top: 20rpx;

  display: flex;

  flex-wrap: wrap;

}



.locate-btn,

.photo-btn {

  width: 100%;

  min-width: 0;

  height: 76rpx;

  padding: 0 12rpx;

  font-size: 28rpx;

}



.form-section {

  margin-top: 20rpx;

  padding: 28rpx 32rpx;

}



.field {

  min-height: 104rpx;

  padding: 18rpx 0;

  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);

  display: flex;

  flex-wrap: wrap;

  align-items: center;

}



.field:last-child {

  border-bottom: 0;

}



.field-label {

  color: rgba(0, 0, 0, 0.9);

  font-size: 30rpx;

  font-weight: 400;

}



.required {

  margin-left: 4rpx;

  color: #fa5151;

}



.field-input,

.field-textarea {

  width: 100%;

  padding: 0 20rpx;

  border-radius: 8rpx;

  background: #f7f7f7;

  color: #191919;

  font-size: 30rpx;

}



.field-input {

  height: 76rpx;

}



.picker-value {

  line-height: 76rpx;

}



.field-textarea {

  min-height: 160rpx;

  padding-top: 18rpx;

  line-height: 1.5;

}



.unit {

  color: rgba(0, 0, 0, 0.5);

  font-size: 24rpx;

}



.section-headline {

  display: flex;

  align-items: center;

  justify-content: space-between;

}



.photo-grid {

  margin-top: 22rpx;

  display: flex;

  flex-direction: column;

}



.photo-item {

  position: relative;

  width: 100%;

  overflow: hidden;

  border-radius: 10rpx;

  background: #f2f2f2;

}



.photo-image {

  display: block;

  width: 100%;

  min-height: 260rpx;

  background: #f2f2f2;

}



.photo-corner-btn {

  position: absolute;

  top: 14rpx;

  right: 14rpx;

  z-index: 2;

  display: flex;

  width: 124rpx;

  min-width: 124rpx;

  max-width: 124rpx;

  margin: 0;

  box-sizing: border-box;

}



.recognize-photo {

  width: 124rpx;

  min-width: 124rpx;

  max-width: 124rpx;

  height: 58rpx;

  margin: 0;

  padding: 0;

  border: 1rpx solid rgba(255, 255, 255, 0.75);

  border-radius: 29rpx;

  background: rgba(7, 193, 96, 0.94);

  color: #ffffff;

  font-size: 24rpx;

  line-height: 58rpx;

  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);

}



.remove-photo {

  position: absolute;

  left: 14rpx;

  top: 14rpx;

  z-index: 2;

  width: 52rpx;

  height: 52rpx;

  margin: 0;

  padding: 0;

  border-radius: 26rpx;

  background: rgba(0, 0, 0, 0.58);

  color: #ffffff;

  font-size: 32rpx;

  line-height: 52rpx;

}



.photo-empty {

  margin-top: 16rpx;

  font-size: 26rpx;

}



.plant-recognition {

  margin-top: 20rpx;

  padding: 18rpx 20rpx;

  border: 1rpx solid rgba(7, 193, 96, 0.26);

  border-radius: 8rpx;

  background: rgba(7, 193, 96, 0.06);

}



.plant-recognition-title {

  color: #1d7a4d;

  font-size: 26rpx;

  font-weight: 600;

}



.plant-recognition-main {

  margin-top: 8rpx;

  color: #191919;

  font-size: 34rpx;

  font-weight: 600;

}



.plant-recognition-latin,

.plant-recognition-confidence,

.plant-recognition-reason,

.plant-recognition-candidates,

.candidate-label,

.candidate-item {

  display: inline;

}



.candidate-item {

  content: ", ";

}



.plant-recognition-warning {

  margin-top: 6rpx;

  color: rgba(0, 0, 0, 0.68);

  font-size: 24rpx;

  line-height: 1.45;

}



.plant-recognition-warning {

  color: #9a5a00;

}



.plant-recognition-actions {

  margin-top: 14rpx;

  display: flex;

  min-width: 0;

}



.recognition-action-btn {

  flex: 1 1 0;

  width: 0;

  min-width: 0;

  height: 68rpx;

  margin: 0;

  padding: 0 8rpx;

  box-sizing: border-box;

  overflow: hidden;

  white-space: nowrap;

  font-size: 26rpx;

  line-height: 68rpx;

}



.submit-btn {

  margin-top: 26rpx;

}

