.search-bar {
  min-height: 96rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  color: #191919;
  font-size: 30rpx;
}

.search-btn {
  width: 128rpx;
  height: 72rpx;
  padding: 0;
  font-size: 28rpx;
}

.create-btn {
  margin-top: 20rpx;
}

.record-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  overflow: hidden;
}

.card-main {
  padding: 28rpx 32rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tree-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #191919;
}

.meta-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx 18rpx;
  color: rgba(0, 0, 0, 0.7);
  font-size: 26rpx;
}

.record-note {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.card-actions {
  padding: 18rpx 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-btn {
  height: 72rpx;
  font-size: 28rpx;
}
