.search-bar {
  min-height: 96rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  color: #191919;
  font-size: 30rpx;
}

.search-btn {
  width: 128rpx;
  height: 72rpx;
  padding: 0;
  font-size: 28rpx;
}

.create-btn {
  margin-top: 20rpx;
}

.record-summary {
  margin: 18rpx 6rpx 0;
  font-size: 24rpx;
}

.record-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.record-card {
  overflow: hidden;
}

.card-main {
  padding: 24rpx;
  display: flex;
}

.cover {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 8rpx;
  background: #f2f2f2;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tree-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: 500;
  color: #191919;
}

.meta-grid {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  color: rgba(0, 0, 0, 0.7);
  font-size: 25rpx;
}

.record-note {
  margin-top: 14rpx;
  font-size: 24rpx;
}

.card-actions {
  padding: 18rpx 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
  display: flex;
  flex-wrap: wrap;
  
}

.card-actions button:only-child {
}

.action-btn {
  height: 72rpx;
  font-size: 28rpx;
}

.pager {
  margin-top: 20rpx;
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.pager-btn {
  height: 72rpx;
  font-size: 28rpx;
}

.pager-text {
  text-align: center;
  color: rgba(0, 0, 0, 0.7);
  font-size: 28rpx;
}
